# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker-compose.dev.yml exposes Postgres on localhost:5432):
DATABASE_URL=postgres://tulparhub:tulparhub@localhost:5432/tulparhub
# DATABASE_POOL_MAX=10

# Production Postgres (used by docker-compose.yml to build DATABASE_URL):
POSTGRES_USER=tulparhub
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=tulparhub

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (https://tulparhub.kz in prod, http://localhost:3000 in dev)
AUTH_URL=http://localhost:3000
# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic-link sender. Resend is the default — create an API key at
# resend.com and verify the tulparhub.kz domain (add the SPF/DKIM DNS records).
# EMAIL_FROM must be an address on that verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@tulparhub.kz
# Fallback SMTP for any non-Resend host (ignored when RESEND_API_KEY is set):
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587

# ── Invoice requisites (счёт на оплату) ───────────────────────────────────────
# Supplier details printed on /invoice/<id>. Placeholders render a "draft" note.
INVOICE_COMPANY=
INVOICE_BIN=
INVOICE_ADDRESS=
INVOICE_IIK=
INVOICE_BANK=
INVOICE_BIK=
INVOICE_KBE=17

# ── Ops notifications (Telegram) ──────────────────────────────────────────────
# Create a bot via @BotFather, add it to the ops group chat. Unset = no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Imports ───────────────────────────────────────────────────────────────────
# Path to the vendor CSV price/stock export (the current source of truth)
CSV_PATH=./data/price.csv
VENDOR_ID=main

# ── Backups (optional offsite) ────────────────────────────────────────────────
# BACKUP_RETENTION_DAYS=14
# OFFSITE_S3=s3://tulparhub-backups

# ── Analytics (Yandex Metrica) ────────────────────────────────────────────────
# 8-digit Metrica tag id. Unset = analytics disabled (no snippet, no calls).
NEXT_PUBLIC_YANDEX_METRICA_ID=
