# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (docker-compose.dev.yml exposes Postgres on localhost:5432):
DATABASE_URL=postgres://tulparhub:tulparhub@localhost:5432/tulparhub
# DATABASE_POOL_MAX=10
# Force/disable TLS for the DB connection (auto-detected from the URL otherwise)
# DATABASE_SSL=true

# Production Postgres (used by docker-compose.yml to build DATABASE_URL):
POSTGRES_USER=tulparhub
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=tulparhub

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (https://tulparhub.kz in prod, http://localhost:3000 in dev)
AUTH_URL=http://localhost:3000
# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic-link sender — Resend HTTP API (not SMTP; Render blocks outbound
# SMTP). Create an API key at resend.com and verify the sending domain (add the
# SPF/DKIM DNS records). EMAIL_FROM must be an address on that verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@tulparhub.kz
# Inbound webhook (vendor CSV feed by email): svix signing secret + allowed senders
RESEND_INBOUND_SECRET=
INBOUND_FEED_SENDERS=supplier@example.com

# ── Invoice requisites (счёт на оплату) ───────────────────────────────────────
# Supplier details printed on /invoice/<id>. Placeholders render a "draft" note.
INVOICE_COMPANY=
INVOICE_BIN=
INVOICE_ADDRESS=
INVOICE_IIK=
INVOICE_BANK=
INVOICE_BIK=
INVOICE_KBE=17

# ── Ops notifications (Telegram) ──────────────────────────────────────────────
# Create a bot via @BotFather, add it to the ops group chat. Unset = no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Imports ───────────────────────────────────────────────────────────────────
# Path to the vendor CSV price/stock export (the current source of truth)
CSV_PATH=./data/price.csv
VENDOR_ID=main
# Product images export, imported via POST /api/admin/import-images
IMAGES_CSV_PATH=./data/price_images.csv
# KZT per USD for the derived price_usd column
# USD_RATE=470

# ── SEO / PWA ─────────────────────────────────────────────────────────────────
# Canonical origin for sitemap/robots/OG links; falls back to AUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://tulparhub.kz

# ── Backups (optional offsite) ────────────────────────────────────────────────
# BACKUP_RETENTION_DAYS=14
# OFFSITE_S3=s3://tulparhub-backups

# ── Analytics (Yandex Metrica) ────────────────────────────────────────────────
# 8-digit Metrica tag id. Unset = analytics disabled (no snippet, no calls).
NEXT_PUBLIC_YANDEX_METRICA_ID=
